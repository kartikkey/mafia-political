{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "baseUrl": "src",
    "paths": {
      "@netagiri/shared": ["shared/index.ts"],
      "api/*": ["api/*"],
      "assets/*": ["assets/*"],
      "common/*": ["common/*"],
      "components/*": ["components/*"],
      "config/*": ["config/*"],
      "constants/*": ["constants/*"],
      "helpers/*": ["helpers/*"],
      "layout/*": ["layout/*"],
      "pages/*": ["pages/*"],
      "routes/*": ["routes/*"],
      "slices/*": ["slices/*"],
      "utils/*": ["utils/*"],
      "store": ["store.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
